[MASTER]
# cv2 is a compiled C extension module; Pylint can't introspect its members
# via static AST analysis and otherwise reports false-positive no-member
# errors (GaussianBlur, resize, INTER_AREA, etc. all exist at runtime).
extension-pkg-allow-list=cv2

[BASIC]
# Allow sklearn's feature-matrix/hyperparameter naming convention (X, y,
# X_train, X_test_emb, C, ...) alongside regular snake_case, used throughout
# model_classical.py and pipeline.py.
argument-rgx=([a-z_][a-z0-9_]{0,30}|[Xy][a-zA-Z0-9_]*|C)$
variable-rgx=([a-z_][a-z0-9_]{0,30}|[Xy][a-zA-Z0-9_]*|C)$
